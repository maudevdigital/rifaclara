---
import Base from "../../layouts/Base.astro";
import { apiServidor } from "../../lib/api-servidor";
import { fechaChile, pesos } from "../../lib/formato";
import { nombrePremio } from "../../lib/sorteo-remoto";

export const prerender = false;

interface RifaPublica {
  slug: string; titulo: string; descripcion: string | null; premios: string[]; precio: number; moneda: string;
  desde: number; hasta: number; cierreEn: number; zonaHoraria: string; estado: string;
  horasReserva: number; maxPorPersona: number; sorteoId: string | null;
  tomados: { n: string; e: "p" | "r" }[];
  resultado: {
    sorteoId: string; estado: "pendiente" | "resuelto"; ronda: number; momento: number; huella: string;
    numerosEnSorteo: number; premios: number; ganadores: { premio: number; numero: string }[];
  } | null;
}
const { estado, datos: r } = await apiServidor<RifaPublica>(Astro.request, `/api/rifas/publica/${encodeURIComponent(Astro.params.slug ?? "")}`);
if (!r) Astro.response.status = estado === 404 ? 404 : 502;

const ancho = r ? String(r.hasta).length : 0;
const estados = new Map(r?.tomados.map((t) => [t.n, t.e]));
const numeros = r ? Array.from({ length: r.hasta - r.desde + 1 }, (_, i) => String(r.desde + i).padStart(ancho, "0")) : [];
const pagados = r?.tomados.filter((t) => t.e === "p").length ?? 0;
const reservados = r?.tomados.filter((t) => t.e === "r").length ?? 0;
const titulo = r ? (/^rifa\b/i.test(r.titulo) ? r.titulo : `Rifa ${r.titulo}`) : "Rifa no encontrada";
const nueva = Astro.url.searchParams.has("nueva");
const abierta = r?.estado === "abierta" && Date.now() / 1000 < r.cierreEn;
const clases = {
  libre: "border-line bg-surface text-ink",
  r: "border-dashed border-muted text-muted",
  p: "border-transparent bg-sold text-sold-ink line-through",
};
---
<Base
  title={`${titulo} | Rifa Clara`}
  description={r ? `${r.premios[0]}. ${numeros.length} números a ${pesos(r.precio)}. Sorteo verificable el ${fechaChile(r.cierreEn, r.zonaHoraria)}.` : "Esta rifa no existe."}
  noindex={!r}
>
  {!r && (
    <section class="grid gap-4 py-16">
      <h1 class="text-4xl font-semibold">No encontramos esta rifa</h1>
      <p class="text-muted">Revisa el enlace o pídeselo de nuevo a quien organiza.</p>
    </section>
  )}
  {r && (
    <div class="grid gap-8 py-6">
      {nueva && (
        <div class="grid gap-2 rounded-2xl bg-ok-soft p-5">
          <b class="text-ok">✓ Tu rifa está publicada</b>
          <p class="text-sm">Comparte este enlace por WhatsApp o Instagram:</p>
          <code data-enlace class="font-mono text-sm break-all">{Astro.url.origin}/r/{r.slug}</code>
          <button data-copiar type="button" class="justify-self-start text-sm font-semibold text-accent underline underline-offset-2">Copiar enlace</button>
        </div>
      )}
      {r.estado !== "abierta" && (
        <section class="grid gap-4 rounded-2xl border border-line bg-surface p-5 sm:p-6">
          {r.resultado?.estado === "resuelto" ? (
            <>
              <span class="text-sm font-semibold tracking-[.14em] text-muted uppercase">Resultado del sorteo</span>
              <ol class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
                {r.resultado.ganadores.map((g) => (
                  <li class="flex items-center justify-between gap-3 rounded-xl border border-line bg-bg px-4 py-3">
                    <span><span class="block text-xs text-muted uppercase">{nombrePremio(g.premio)}</span><span class="font-semibold">{r.premios[g.premio]}</span></span>
                    <span class="rounded-md bg-pick px-3 py-1 font-mono text-2xl font-semibold text-pick-ink">{g.numero}</span>
                  </li>
                ))}
              </ol>
              <p class="text-sm text-muted">Sorteo entre {r.resultado.numerosEnSorteo} números pagados con la ronda {r.resultado.ronda} de drand. <a class="text-accent underline" href={`/sorteo/${r.resultado.sorteoId}`}>Ver comprobante y verificar</a></p>
            </>
          ) : r.resultado ? (
            <>
              <span class="text-sm font-semibold tracking-[.14em] text-muted uppercase">Sorteo en curso</span>
              <p>La lista de {r.resultado.numerosEnSorteo} números pagados ya está sellada. El resultado sale con la ronda {r.resultado.ronda} de drand, en segundos.</p>
              <a href={`/r/${r.slug}/sorteo`} class="justify-self-start rounded-xl bg-accent px-5 py-3 font-semibold text-accent-ink">Ver el sorteo en vivo</a>
            </>
          ) : (
            <p>Esta rifa cerró sin números pagados, así que no hubo sorteo.</p>
          )}
        </section>
      )}
      <section class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <div class="grid content-start gap-4">
          <span class="inline-flex items-center gap-2 justify-self-start rounded-full bg-ok-soft px-3 py-1.5 font-mono text-xs text-ok">
            <i class="size-1.5 rounded-full bg-ok"></i>{r.estado === "abierta" ? "Abierta · sorteo verificable" : r.estado === "sorteada" ? "Sorteada" : "Cerrada · sorteando"}
          </span>
          <h1 class="text-4xl leading-tight font-semibold tracking-tight sm:text-5xl">{titulo}</h1>
          {r.descripcion && <p class="max-w-[60ch] leading-relaxed whitespace-pre-line text-muted">{r.descripcion}</p>}
          <ol class="grid gap-2">
            {r.premios.map((p, i) => (
              <li class="flex items-baseline gap-3 rounded-xl border border-line bg-surface px-4 py-3">
                <span class="text-xs font-semibold whitespace-nowrap text-muted uppercase">{nombrePremio(i)}</span>
                <span class="font-semibold">{p}</span>
              </li>
            ))}
          </ol>
          <div class="flex flex-wrap gap-8">
            <span><b class="block font-mono text-3xl font-semibold">{pesos(r.precio)}</b><span class="text-sm text-muted">por número</span></span>
            <span><b class="block font-mono text-3xl font-semibold">{numeros.length - pagados - reservados}</b><span class="text-sm text-muted">números libres de {numeros.length}</span></span>
          </div>
          <p class="text-sm text-muted">El sorteo es el <b class="text-ink">{fechaChile(r.cierreEn, r.zonaHoraria)}</b> (hora de Chile), con un número aleatorio público que cualquiera puede verificar.{r.estado === "abierta" && <> <a class="text-accent underline" href={`/r/${r.slug}/sorteo`}>Página del sorteo en vivo</a></>}</p>
        </div>

        <div data-rifa data-slug={r.slug} data-precio={r.precio} data-maximo={r.maxPorPersona} class="grid gap-4 rounded-2xl border border-line bg-surface p-4 sm:p-5">
          <div class="h-1.5 overflow-hidden rounded-full bg-sold"><b class="block h-full rounded-full bg-ok" style={`width:${(pagados / numeros.length) * 100}%`}></b></div>
          <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted">
            <span><i class="mr-1 inline-block size-2.5 rounded-sm border border-line align-middle"></i>Libre</span>
            <span><i class="mr-1 inline-block size-2.5 rounded-sm bg-pick align-middle"></i>Tu elección</span>
            <span><i class="mr-1 inline-block size-2.5 rounded-sm border border-dashed border-muted align-middle"></i>Reservado ({reservados})</span>
            <span><i class="mr-1 inline-block size-2.5 rounded-sm bg-sold align-middle"></i>Vendido ({pagados})</span>
          </div>
          {abierta && <p class="text-sm text-muted">Toca los números que quieres. Puedes elegir hasta {r.maxPorPersona}.</p>}
          <div class:list={["grid grid-cols-10 gap-1 sm:gap-1.5", numeros.length > 200 && "md:grid-cols-20"]} aria-label="Números de la rifa">
            {numeros.map((n) => {
              const e = estados.get(n);
              const base = "grid aspect-square place-items-center rounded-md border font-mono text-[11px] sm:text-xs";
              return abierta && !e ? (
                <button type="button" data-numero={n} aria-pressed="false" data-clase-tomado={`${base} ${clases.r}`}
                  class={`${base} ${clases.libre} cursor-pointer hover:border-accent aria-pressed:border-pick aria-pressed:bg-pick aria-pressed:font-semibold aria-pressed:text-pick-ink`}>{n}</button>
              ) : (
                <span class:list={[base, clases[e ?? "libre"]]} aria-label={`${n}, ${e === "p" ? "vendido" : e === "r" ? "reservado" : "no disponible"}`}>{n}</span>
              );
            })}
          </div>
          <p data-aviso hidden class="text-sm text-danger"></p>

          {abierta ? (
            <>
              <div data-barra hidden class="sticky bottom-3 z-10 grid gap-2 rounded-xl bg-ink p-3 text-bg shadow-lg sm:flex sm:items-center sm:justify-between">
                <span data-resumen class="font-mono text-sm"></span>
                <button data-continuar type="button" class="rounded-lg bg-pick px-4 py-2.5 text-sm font-semibold text-pick-ink">Reservar</button>
              </div>
              <form data-reservar hidden class="grid gap-3 rounded-xl border border-line bg-bg p-4" novalidate>
                <b>Tus datos</b>
                <label class="grid gap-1 text-sm font-medium" for="reserva-nombre">Nombre y apellido
                  <input id="reserva-nombre" name="nombre" autocomplete="name" required maxlength="60" class="rounded-lg border border-line bg-surface px-3 py-2.5 text-ink focus:border-accent focus:outline-none" />
                </label>
                <label class="grid gap-1 text-sm font-medium" for="reserva-telefono">WhatsApp
                  <input id="reserva-telefono" name="telefono" type="tel" inputmode="tel" autocomplete="tel" required placeholder="+56 9 1234 5678" class="rounded-lg border border-line bg-surface px-3 py-2.5 text-ink focus:border-accent focus:outline-none" />
                </label>
                <div class="absolute -left-[9999px]" aria-hidden="true"><label for="reserva-sitio">Sitio</label><input id="reserva-sitio" name="sitio" tabindex="-1" autocomplete="off" /></div>
                <p class="text-xs text-muted">Tus números quedan reservados {r.horasReserva} horas mientras pagas. Solo quien organiza ve tu teléfono.</p>
                <button type="submit" class="justify-self-start rounded-xl bg-accent px-6 py-3 font-semibold text-accent-ink hover:brightness-110 disabled:opacity-60">Confirmar reserva</button>
                <p data-mensaje aria-live="polite" class="min-h-5 text-sm"></p>
              </form>
            </>
          ) : (
            <p class="rounded-lg bg-salvia px-3 py-2 text-sm">Las reservas de esta rifa están cerradas.</p>
          )}
          <div data-mis-boletos hidden class="flex flex-wrap items-baseline gap-3 border-t border-line pt-3 text-sm"><span class="text-muted">Tus boletos:</span></div>
        </div>
      </section>
    </div>
  )}
</Base>

<script>
  import "../../scripts/rifa-publica.ts";
  const boton = document.querySelector<HTMLButtonElement>("[data-copiar]");
  boton?.addEventListener("click", async () => {
    const texto = document.querySelector("[data-enlace]")?.textContent ?? "";
    try { await navigator.clipboard.writeText(texto); boton.textContent = "Enlace copiado"; } catch {}
  });
</script>
