---
// Lista de espera para organizadores: valida demanda y disposición a pagar
// antes de construir la fase 2. La lógica vive en src/scripts/lista-espera.ts.
interface Props {
  origen: string;
  titulo?: string;
}
const { origen, titulo = "Avísame cuando pueda crear mi rifa" } = Astro.props;
const campo = "w-full rounded-lg border border-line bg-bg px-3 py-2.5 text-sm text-ink focus:border-accent focus:outline-none";
---
<section id="lista" class="grid gap-5 rounded-2xl border border-line bg-surface p-5 sm:p-8 lg:grid-cols-[minmax(0,.9fr)_minmax(0,1.1fr)]">
  <div class="grid content-start gap-3">
    <span class="justify-self-start rounded-full bg-pick px-3 py-1 text-xs font-semibold text-pick-ink">Lista de espera</span>
    <h2 class="text-2xl font-semibold">{titulo}</h2>
    <p class="leading-relaxed text-muted">Estamos construyendo la rifa completa: grilla de números, reservas, control de pagos y sorteo verificable al cierre. Déjanos tu correo y te avisamos apenas puedas crear la tuya.</p>
    <p class="text-sm text-muted">Gratis hasta 100 números. Sin comisión por venta.</p>
  </div>
  <form data-lista-espera data-origen={origen} class="grid gap-4" novalidate>
    <label class="grid gap-1 text-sm font-medium" for={`lista-email-${origen}`}>Correo
      <input id={`lista-email-${origen}`} name="email" type="email" autocomplete="email" required placeholder="tu@correo.cl" class={campo} />
    </label>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="grid gap-1 text-sm font-medium" for={`lista-tipo-${origen}`}>¿Quién organiza?
        <select id={`lista-tipo-${origen}`} name="tipo" required class={campo}>
          <option value="">Elige una opción</option>
          <option value="bomberos">Bomberos</option>
          <option value="colegio">Colegio o centro de padres</option>
          <option value="club">Club deportivo</option>
          <option value="fundacion">Fundación u ONG</option>
          <option value="junta">Junta de vecinos</option>
          <option value="persona">Persona, para una causa</option>
          <option value="otro">Otro</option>
        </select>
      </label>
      <label class="grid gap-1 text-sm font-medium" for={`lista-numeros-${origen}`}>Tamaño de tus rifas
        <select id={`lista-numeros-${origen}`} name="numeros" required class={campo}>
          <option value="">Elige una opción</option>
          <option value="100">Hasta 100 números</option>
          <option value="500">Hasta 500</option>
          <option value="2000">Hasta 2.000</option>
          <option value="mas">Más de 2.000</option>
        </select>
      </label>
    </div>
    <fieldset class="grid gap-2">
      <legend class="text-sm font-medium">¿Pagarías $4.990, una sola vez, por una rifa de hasta 500 números sin comisión?</legend>
      <div class="flex flex-wrap gap-2">
        {[["si", "Sí"], ["tal-vez", "Tal vez"], ["no", "No"]].map(([valor, texto]) => (
          <label class="opcion" for={`lista-pagaria-${valor}-${origen}`}>
            <input id={`lista-pagaria-${valor}-${origen}`} type="radio" name="pagaria" value={valor} class="sr-only" />{texto}
          </label>
        ))}
      </div>
    </fieldset>
    <!-- Campo trampa para bots: invisible para las personas. -->
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for={`lista-sitio-${origen}`}>Sitio web</label>
      <input id={`lista-sitio-${origen}`} name="sitio" tabindex="-1" autocomplete="off" />
    </div>
    <button type="submit" class="justify-self-start rounded-xl bg-accent px-6 py-3 font-semibold text-accent-ink hover:brightness-110 disabled:opacity-60">Avísame</button>
    <p data-mensaje aria-live="polite" class="min-h-5 text-sm"></p>
    <p class="text-xs text-muted">Solo te escribiremos por esto. Puedes pedir que te borremos cuando quieras. <a class="underline" href="/privacidad">Privacidad</a>.</p>
  </form>
</section>

<style>
  .opcion {
    cursor: pointer;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: 0.45rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }
  .opcion:has(input:checked) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .opcion:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>

<script>
  import "../scripts/lista-espera.ts";
</script>
