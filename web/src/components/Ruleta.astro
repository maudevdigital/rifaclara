---
// Herramienta de la ruleta. La lógica vive en src/scripts/ruleta.ts.
const ejemplo = ["Camila", "Benjamín", "Josefa", "Matías", "Florencia", "Vicente", "Antonia", "Agustín"];
const boton = "rounded-lg border border-line bg-surface px-3 py-2 text-sm font-medium hover:border-accent hover:text-accent";
---
<div data-ruleta class="grid items-start gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,.85fr)]">
  <div data-escenario class="escenario grid justify-items-center gap-4 rounded-2xl border border-line bg-surface p-4 sm:p-6">
    <div class="relative aspect-square w-full max-w-[560px]">
      <canvas data-rueda class="size-full cursor-pointer" role="img" aria-label="Ruleta con los nombres de la lista. Haz clic para girar."></canvas>
      <span class="puntero" aria-hidden="true"></span>
      <div data-dialogo hidden class="absolute inset-0 grid place-items-center p-4">
        <div role="dialog" aria-labelledby="ruleta-gano" class="grid w-full max-w-sm gap-4 rounded-2xl border border-line bg-surface p-6 text-center shadow-[0_24px_60px_rgb(10_40_35/.25)]">
          <span id="ruleta-gano" class="text-xs font-semibold tracking-[.14em] text-muted uppercase">Ganó</span>
          <span data-ganador class="font-display text-4xl leading-tight font-semibold break-words text-accent"></span>
          <div data-prueba hidden class="grid gap-1.5 rounded-lg bg-ok-soft px-3 py-2.5 text-left">
            <span class="text-xs font-semibold text-ok">✓ Sorteo verificable</span>
            <span data-prueba-detalle class="font-mono text-[11px] break-words text-ink"></span>
            <button data-copiar type="button" class="justify-self-start text-xs font-semibold text-accent underline underline-offset-2">Copiar comprobante</button>
          </div>
          <div class="flex flex-wrap justify-center gap-2">
            <button data-quitar-ganador type="button" class={boton}>Quitar de la lista</button>
            <button data-cerrar type="button" class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-accent-ink hover:brightness-110">Seguir</button>
          </div>
        </div>
      </div>
    </div>
    <div class="flex flex-wrap justify-center gap-2">
      <button data-girar type="button" class="rounded-xl bg-accent px-7 py-3.5 font-semibold text-accent-ink hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-50">Girar la ruleta</button>
      <button data-pantalla type="button" class={boton}>Pantalla completa</button>
    </div>
    <p data-estado aria-live="polite" class="min-h-5 text-center text-sm text-muted"></p>
  </div>

  <div class="grid gap-4">
    <div class="grid gap-3 rounded-2xl border border-line bg-surface p-4">
      <div class="flex items-baseline justify-between">
        <label for="ruleta-nombres" class="font-semibold">Nombres u opciones</label>
        <span data-cuenta class="font-mono text-sm text-muted">{ejemplo.length}</span>
      </div>
      <textarea id="ruleta-nombres" data-nombres rows="9" spellcheck="false" class="w-full resize-y rounded-lg border border-line bg-bg px-3 py-2.5 font-mono text-sm leading-relaxed text-ink focus:border-accent focus:outline-none">{ejemplo.join("\n")}</textarea>
      <p class="text-xs text-muted">Uno por línea, hasta 500. Se guardan solo en este navegador. <kbd class="font-mono">Ctrl</kbd> + <kbd class="font-mono">Enter</kbd> gira.</p>
      <div class="flex flex-wrap gap-2">
        <button data-mezclar type="button" class={boton}>Mezclar</button>
        <button data-ordenar type="button" class={boton}>Ordenar A–Z</button>
        <button data-borrar type="button" class={boton}>Borrar todo</button>
      </div>
    </div>

    <fieldset class="grid gap-3 rounded-2xl border border-line bg-surface p-4">
      <legend class="sr-only">Opciones del giro</legend>
      <div class="grid grid-cols-2 rounded-lg border border-line p-1 text-sm font-semibold" role="radiogroup" aria-label="Modo del sorteo">
        <label class="modo"><input type="radio" id="ruleta-modo-rapido" name="ruleta-modo" value="rapido" checked class="sr-only" />Rápido</label>
        <label class="modo"><input type="radio" id="ruleta-modo-verificable" name="ruleta-modo" value="verificable" class="sr-only" />Verificable</label>
      </div>
      <p data-modo-ayuda class="text-xs leading-relaxed text-muted"></p>
      <label class="flex items-center gap-2 text-sm" for="ruleta-quitar">
        <input type="checkbox" id="ruleta-quitar" data-quitar class="size-4 accent-[var(--accent)]" />
        Quitar al ganador de la lista después de cada giro
      </label>
    </fieldset>

    <div class="grid gap-2 rounded-2xl border border-line bg-surface p-4">
      <h2 class="text-base font-semibold">Ganadores</h2>
      <ol data-historial class="grid gap-1.5 text-sm"></ol>
      <p data-historial-vacio class="text-sm text-muted">Todavía no hay giros.</p>
    </div>
  </div>
</div>

<style>
  .puntero {
    position: absolute;
    top: -4px;
    left: 50%;
    translate: -50% 0;
    border-inline: 15px solid transparent;
    border-top: 28px solid var(--accent);
    filter: drop-shadow(0 2px 2px rgb(0 0 0 / 0.25));
    pointer-events: none;
  }
  .modo {
    display: grid;
    place-items: center;
    padding-block: 0.5rem;
    border-radius: 0.4rem;
    color: var(--muted);
    cursor: pointer;
  }
  .modo:has(input:checked) {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .modo:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .escenario:fullscreen {
    align-content: center;
    background: var(--bg);
    border: 0;
    border-radius: 0;
  }
  .escenario:fullscreen > div:first-child {
    max-width: min(88vh, 92vw);
  }
</style>

<script>
  import "../scripts/ruleta.ts";
</script>
