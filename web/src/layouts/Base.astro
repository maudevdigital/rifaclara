---
import "../styles/global.css";
import Logo from "../components/Logo.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
// Con build.format "file" la ruta llega como /ruleta.html al prerenderizar.
const ruta = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/");
const canonical = new URL(ruta, Astro.site);
const enlaces = [
  { href: "/ruleta", texto: "Ruleta" },
  { href: "/sorteo-de-rifa", texto: "Sorteo de rifa" },
  { href: "/guias", texto: "Guías" },
];
---
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CL" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <header class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-5">
      <Logo />
      <nav class="flex w-full items-center gap-5 overflow-x-auto text-sm text-muted sm:w-auto" aria-label="Principal">
        {enlaces.map(({ href, texto }) => (
          <a class="whitespace-nowrap hover:text-ink aria-[current=page]:font-semibold aria-[current=page]:text-ink" href={href} aria-current={ruta === href || ruta.startsWith(href + "/") ? "page" : undefined}>{texto}</a>
        ))}
      </nav>
    </header>
    <main class="mx-auto max-w-6xl px-5">
      <slot />
    </main>
    <footer class="mx-auto mt-24 flex max-w-6xl flex-wrap justify-between gap-4 border-t border-line px-5 py-8 text-sm text-muted">
      <span>Rifa Clara · rifas con sorteo verificable</span>
      <a class="hover:text-ink" href="https://maudev.cl">Hecho por Maudev</a>
    </footer>
  </body>
</html>
