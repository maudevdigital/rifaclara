{
  "name": "rifaclara",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w @rifaclara/api",
    "dev:web": "npm run dev -w @rifaclara/web",
    "build": "npm run build -w @rifaclara/web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "local:api": "npm run dev -w @rifaclara/api",
    "local:web": "npm run build && npm run local -w @rifaclara/web",
    "test:seo": "node scripts/auditar-seo.mjs",
    "gen:imagenes": "node scripts/generar-imagenes.mjs"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "sharp": true
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "typescript": "^7.0.2"
  }
}
