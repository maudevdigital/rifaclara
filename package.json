{
  "name": "rifaclara",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w @rifaclara/api",
    "dev:web": "npm run dev -w @rifaclara/web",
    "build": "npm run build -w @rifaclara/web",
    "test": "npm test -w @rifaclara/shared",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "sharp": true
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
