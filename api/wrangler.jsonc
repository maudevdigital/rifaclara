{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rifaclara-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  // Solo se entra por el service binding de rifaclara-web.
  "workers_dev": false,
  "preview_urls": false,
  // En local se sobrescriben con .dev.vars. RESEND_API_KEY es un secreto:
  // npx wrangler secret put RESEND_API_KEY
  "vars": { "SITIO": "https://rifaclara.maudev.cl", "ENTORNO": "produccion" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rifaclara",
      "database_id": "5f1e408b-4b5f-4ac7-a305-6cf04afef219",
      "migrations_dir": "migrations"
    }
  ],
  // Tope de sorteos nuevos por IP, para que nadie llene la base.
  "ratelimits": [
    { "name": "LIMITE_SORTEOS", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "LIMITE_FORMULARIOS", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  // Un solo cron (la cuenta gratuita admite 5 en total, compartidos con los
  // workers de maudev): cada 10 minutos vence reservas; la pasada de las 07:00
  // UTC además borra sorteos de más de 90 días y sesiones o enlaces vencidos.
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
